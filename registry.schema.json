{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Registre central des WP OFCE",
  "type": "object",
  "required": ["wp"],
  "properties": {
    "wp": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["annee", "wp", "type", "registered-by", "registered-at"],
        "additionalProperties": false,
        "properties": {
          "annee": { "type": "integer", "minimum": 2000 },
          "wp": { "type": "integer", "minimum": 1 },
          "type": { "type": "string", "enum": ["repo", "pdf-only"] },
          "source-repo": { "type": ["string", "null"] },
          "contact": { "type": ["string", "null"] },
          "registered-by": { "type": ["string", "null"] },
          "registered-at": { "type": "string", "format": "date" },
          "pdf-path": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "repo" } } },
            "then": {
              "required": ["source-repo", "contact"],
              "properties": {
                "source-repo": {
                  "type": "string",
                  "pattern": "^ofce/.+"
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "pdf-only" } } },
            "then": {
              "required": ["pdf-path"],
              "properties": {
                "source-repo": { "type": "null" },
                "pdf-path": {
                  "type": "string",
                  "pattern": "^pdf/dtravail/.+\\.pdf$"
                }
              }
            }
          }
        ]
      }
    }
  }
}

